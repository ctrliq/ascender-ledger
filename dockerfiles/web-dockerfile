FROM rockylinux/rockylinux:9

# Installing dependencies for the PHP modules
RUN dnf -y install epel-release
RUN dnf -y update
# Rocky 9 defaults to PHP 8.0, which the locked Twig release no longer supports; use the 8.3 stream
RUN dnf -y module enable php:8.3
RUN dnf install -y zip php php-fpm nginx supervisor git

# Installing additional PHP modules
RUN dnf install -y php-gd php-mbstring php-mysqli php-pdo php-mysqlnd php-xml php-json php-pecl-apcu

# Install Composer so it's available
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

RUN mkdir -p /var/run/php-fpm/
# The pool runs as nginx; let it write its error log (the package makes the directory apache's)
RUN chown nginx:nginx /var/log/php-fpm
RUN rm -fr /etc/nginx/conf.d/php-fpm.conf

COPY ./files/web.conf /etc/nginx/conf.d/default.conf
COPY ./files/nginx.conf /etc/nginx/nginx.conf
COPY ./files/supervisor-web.conf /etc/supervisord.conf
COPY ./files/php-fpm.conf /etc/php-fpm.d/www.conf

COPY ./src /var/www/html

# Install exactly what composer.lock pins, without development packages
RUN cd /var/www/html && COMPOSER_ALLOW_SUPERUSER=1 /usr/local/bin/composer install --no-dev --optimize-autoloader --no-interaction

RUN mkdir -p /var/www/cache/ && chown nginx:nginx -R /var/www/cache/

# TESTING
#RUN dnf install -y procps-ng net-tools which

# Install our Crontab
RUN dnf -y install cronie

COPY files/web-cron /etc/cron.d/web-cron
 
# Give execution rights on the cron job
RUN chmod 0644 /etc/cron.d/web-cron

# Fix php session permissions
RUN chown -R nginx:nginx /var/lib/php

# Apply cron job
RUN crontab /etc/cron.d/web-cron

RUN dnf clean all

CMD ["/usr/bin/supervisord","-c","/etc/supervisord.conf","-n","-s","-k"]

